composer.phar

# Node & Frontend (jika pakai npm)
/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#--------------------------------------------------------------------
# Temporary & Cache Files (CI4)
#--------------------------------------------------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

php_errors.log

#--------------------------------------------------------------------
# User Uploads (Public)
#--------------------------------------------------------------------
/public/uploads/*
!/public/uploads/index.html
!/public/uploads/.gitkeep
/public/null/

